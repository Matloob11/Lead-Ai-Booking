[Unit]
Description=A7 private recording AI transcription and scoring worker
Documentation=file:///opt/a7-3cx-worker/current/README.md
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/a7-3cx-worker/current/a7_3cx_worker.py
ConditionPathExists=/opt/a7-3cx-worker/current/a7_ai_worker_entrypoint.sh
ConditionPathExists=/etc/a7-3cx-worker/worker.env
ConditionPathExists=/etc/a7-3cx-worker/storage.conf

[Service]
Type=oneshot
User=bitrix
Group=bitrix
WorkingDirectory=/opt/a7-3cx-worker/current
Environment=HOME=/home/bitrix
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=AWS_EC2_METADATA_DISABLED=true
Environment=AWS_SHARED_CREDENTIALS_FILE=/home/bitrix/.aws/credentials
Environment=AWS_CONFIG_FILE=/home/bitrix/.aws/config
Environment=A7_WORKER_CONFIG_FILE=/etc/a7-3cx-worker/worker.env
Environment=A7_STORAGE_CONFIG_FILE=/etc/a7-3cx-worker/storage.conf
EnvironmentFile=/etc/a7-3cx-worker/storage.conf
EnvironmentFile=/etc/a7-3cx-worker/worker.env
ExecStart=/usr/bin/bash /opt/a7-3cx-worker/current/a7_ai_worker_entrypoint.sh
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/a7-3cx-worker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
