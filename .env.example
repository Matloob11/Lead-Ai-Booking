# Copy to .env and fill. Never commit real values.
BITRIX_WEBHOOK_BASE=https://crm.example.com/rest/1/REPLACE_WEBHOOK_CODE
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BITRIX_HEALTH_ENTITY=lead
BITRIX_HEALTH_FIELD=UF_CRM_CONVERSATION_HEALTH
BITRIX_AI_MONITOR_FIELD=UF_CRM_AI_MONITOR
BITRIX_WA_CHAT_FIELD=UF_CRM_WA_CHAT
BITRIX_WA_LEAD_STATUS=UC_WA_LEADS
BITRIX_LEAD_URL_BASE=https://crm.a7grouprealestatedxb.com/crm/lead/details

# Bitrix Team Lead phone mask (CRM + Owner Data). Same password for all heads.
# Live file: /bitrix/php_interface/a7_tl_phone_mask.config.php (or set env on CRM host)
A7_TL_PHONE_MASK_PASSWORD=admin123
CONVERSATION_HEALTH_ENABLED=true
