# Agent Daily Reports — copy to agent-reports/.env on the server (never commit real secrets)

AGENT_REPORT_BITRIX_WEBHOOK=https://crm.a7grouprealestatedxb.com/rest/1/REPLACE/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sales Department tree + Re-Sale / TS-related
AGENT_REPORT_DEPT_IDS=60,61,62,63,65,66,67,68,41,43,45,46,52,54

# Messenger digest recipients
AGENT_REPORT_MESSENGER_USER_IDS=1,32,2311,2319

AGENT_REPORT_TZ=Asia/Dubai
AGENT_REPORT_CRON_HOUR=18
AGENT_REPORT_CRON_MINUTE=0

# Owner Data SPA
AGENT_REPORT_OWNER_DATA_ENTITY_TYPE_ID=1042

DATABASE_URL=postgresql+psycopg://agent_reports:agent_reports@postgres:5432/agent_reports
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/reports
