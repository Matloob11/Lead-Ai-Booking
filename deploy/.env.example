# Copy to deploy/.env on the server and fill in. Never commit the filled copy.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=wa.srv1802669.hstgr.cloud,127.0.0.1,localhost
LOG_LEVEL=INFO

PANEL_BASE_URL=https://wa.srv1802669.hstgr.cloud
BITRIX_PORTAL_URL=https://crm.a7grouprealestatedxb.com

POSTGRES_DB=a7wa
POSTGRES_USER=a7wa
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# alots.io (WBBOX). One key for the whole account, from My Profile.
ALOTS_BASE_URL=https://alots.io
ALOTS_API_KEY=
ALOTS_VERSION=v23.0
ALOTS_TIMEOUT=30
# Omni Live Agent session cookie lives in a file, not an env var: the cookie
# contains `$` and Compose would interpolate it to empty. Captcha blocks login.
ALOTS_UI_COOKIE_FILE=/run/alots.ui.cookie

# Shared secret. Set the same value as the Bearer token on every number's
# webhook in the alots panel. Callbacks without it are rejected.
ALOTS_WEBHOOK_TOKEN=generate-another-long-random-string

# Meta System User token — required for Remove template in the panel. alots
# forwards template create (POST) but not delete (405). Same token as in alots
# WABA settings; needs whatsapp_business_management on the production WABAs.
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com

SESSION_WINDOW_HOURS=24

# Only needed once the Bitrix local application is registered.
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
