# Port the API and the panel are served on.
PORT=8300

# Postgres. Its own database — this service does not share the Django one yet.
DATABASE_URL=postgres://waqr:waqr@postgres:5432/waqr

# Where session auth data and downloaded media live. Must be a volume: losing
# the auth directory means every linked phone has to scan again.
DATA_ROOT=/data

# Numbers this service must never link, digits only, comma separated.
# The 21 numbers on the WhatsApp Business Platform go here. Linking one of them
# by QR would put a verified number with ~260 approved templates at risk of a
# permanent ban, and there is no undoing that.
BLOCKED_NUMBERS=971524077268,971524473103,971524492026,971555306149,971555497521,971555689029,971555716422,971555817694,971555832603,971555850765,971555956439,971556037342,971556059331,971556082710,971556354628,971556441831,971559193588,971559430556,971559477395,971559668904,971559481572

# Media larger than this is recorded but not downloaded.
MAX_MEDIA_MB=25

# Phase 2 only — leave empty until the two halves are joined.
# When set, every normalised event is POSTed here with a Bearer token, in the
# same shape the alots gateway sends, so the Django backend needs no new parser.
WEBHOOK_URL=
WEBHOOK_TOKEN=
